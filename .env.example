# AWS Configuration
# Option 1: Use AWS SSO (Recommended for local development)
# No credentials needed - use 'aws sso login' command
AWS_REGION=us-east-1

# Option 2: Use explicit credentials (if needed)
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_SESSION_TOKEN=your_session_token_here_if_needed

# Option 3: Use specific AWS CLI profile
# AWS_PROFILE=your-profile-name

# DynamoDB Configuration
DYNAMODB_TABLE_NAME=SymenticProfileEngrams-prod

# Server Configuration
PORT=3001
NODE_ENV=development