{
  "name": "symentic-api",
  "version": "1.0.0",
  "description": "API server for Symentic DynamoDB data",
  "main": "server.ts",
  "scripts": {
    "dev": "nodemon --exec tsx server.ts",
    "dev:standalone": "nodemon --exec tsx server-standalone.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:standalone": "tsx server-standalone.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "@aws-sdk/client-dynamodb": "^3.848.0",
    "@aws-sdk/lib-dynamodb": "^3.856.0",
    "aws-amplify": "^6.15.3",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "nodemon": "^3.0.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}